<?xml version="1.0" encoding="UTF-8"?>
<!-- Logs go only to a flat file so they never interrupt the game text in the console. -->
<Configuration status="WARN">
    <Appenders>
        <File name="GameLog" fileName="logs/drowned-archive.log">
            <!-- %enc stops a newline in typed input from forging a fake log entry. -->
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{1} - %enc{%m}{CRLF}%n%ex"/>
        </File>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="GameLog"/>
        </Root>
    </Loggers>
</Configuration>
